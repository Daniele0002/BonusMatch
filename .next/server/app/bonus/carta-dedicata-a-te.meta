{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/bonus/layout,_N_T_/bonus/[slug]/layout,_N_T_/bonus/[slug]/page,_N_T_/bonus/carta-dedicata-a-te/"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/bonus/$d$slug/__PAGE__",
    "/bonus/$d$slug",
    "/bonus",
    "/_index",
    "/_head"
  ]
}