5:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"GovernmentService\",\"name\":\"Assegno Unico e Universale\",\"description\":\"Sostegno economico mensile alle famiglie per ogni figlio a carico fino ai 21 anni (senza limiti per disabili).\",\"provider\":{\"@type\":\"GovernmentOrganization\",\"name\":\"Governo Italiano\"},\"serviceType\":\"Agevolazione fiscale\",\"areaServed\":{\"@type\":\"Country\",\"name\":\"Italia\"},\"offers\":{\"@type\":\"Offer\",\"price\":2400,\"priceCurrency\":\"EUR\"},\"url\":\"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-unico-e-universale-per-i-figli-a-carico-55984.assegno-unico-e-universale-per-i-figli-a-carico.html\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://bonusmatch.it/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Famiglia\",\"item\":\"https://bonusmatch.it/categoria/famiglia/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Assegno Unico e Universale\"}]}"}}],["$","$Le",null,{"bonus":{"id":"b25","titolo":"Assegno Unico e Universale","descrizione":"Sostegno economico mensile alle famiglie per ogni figlio a carico fino ai 21 anni (senza limiti per disabili).","valoreEsimato":2400,"status":"scaduto","difficolta":"bassa","requisiti":["Figli a carico","Cittadinanza italiana o UE","Soggiorno in Italia"],"documenti":["ISEE (per importo massimo)","IBAN per accredito","Codici fiscali figli"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-unico-e-universale-per-i-figli-a-carico-55984.assegno-unico-e-universale-per-i-figli-a-carico.html","tempistica":"Mensile","procedura":["Compila la DSU per ottenere l'ISEE aggiornato.","Invia la domanda tramite il sito INPS o tramite un Patronato.","Assicurati che l'IBAN sia intestato o cointestato al richiedente.","Ricevi l'accredito automatico ogni mese."],"categoria":"Famiglia"},"allBonuses":[{"id":"b01","titolo":"Bonus sociale energia","descrizione":"Sconto in bolletta per l’energia elettrica destinato a famiglie con ISEE basso.","valoreEsimato":204.4,"status":"attivo","difficolta":"bassa","requisiti":["ISEE fino a 9.350 euro per nuclei con massimo tre figli a carico","ISEE fino a 20.000 euro per famiglie con almeno quattro figli a carico"],"documenti":["Dichiarazione Sostitutiva Unica (DSU)","Attestazione ISEE in corso di validità"],"linkPortale":null,"tempistica":"Importo annuo variabile in base al numero di componenti","procedura":["Presenta la DSU per ottenere l’ISEE aggiornato.","Il bonus viene riconosciuto automaticamente in bolletta se sussistono i requisiti."],"categoria":"Energia"},{"id":"b02","titolo":"Bonus sociale gas","descrizione":"Sconto in bolletta per il gas naturale in favore di famiglie con ISEE basso.","valoreEsimato":156.4,"status":"attivo","difficolta":"bassa","requisiti":["ISEE fino a 9.350 euro per nuclei con massimo tre figli a carico","ISEE fino a 20.000 euro per famiglie con almeno quattro figli a carico"],"documenti":["Dichiarazione Sostitutiva Unica (DSU)","Attestazione ISEE in corso di validità"],"linkPortale":null,"tempistica":"Importo variabile per componenti nucleo, uso gas e zona climatica","procedura":["Presenta la DSU per ottenere l’ISEE aggiornato.","Il bonus viene applicato automaticamente in bolletta se sussistono i requisiti."],"categoria":"Energia"},{"id":"b03","titolo":"Bonus energia disagio fisico","descrizione":"Agevolazione sulla bolletta elettrica per persone che usano apparecchiature elettromedicali salvavita.","valoreEsimato":463.55,"status":"attivo","difficolta":"media","requisiti":["Cliente domestico affetto da grave malattia che richiede apparecchiature elettromedicali per il mantenimento in vita","Oppure presenza nel nucleo di soggetto in tali condizioni","Fornitura elettrica domestica attiva presso l’abitazione interessata"],"documenti":["Documento di identità del richiedente","Certificazione medica rilasciata da struttura competente","Dati della fornitura elettrica"],"linkPortale":null,"tempistica":"Importo annuo variabile in base alla potenza impegnata e ai macchinari","procedura":["Compila il modulo di domanda disponibile presso il Comune o ente delegato (es. CAF).","Presenta la richiesta al Comune di residenza o altro ente designato."],"categoria":"Energia"},{"id":"b04","titolo":"Bonus ristrutturazione","descrizione":"Detrazione in 10 anni: 50% fino a 96.000 euro per abitazioni principali, 36% per altri immobili","valoreEsimato":null,"status":"attivo","difficolta":"alta","requisiti":["Spese per interventi di recupero del patrimonio edilizio ammessi","Immobili esistenti e regolarmente accatastati","Pagamenti effettuati con bonifico parlante"],"documenti":["Fatture delle imprese o professionisti","Bonifici parlanti","Eventuali autorizzazioni edilizie"],"linkPortale":"https://www.agenziaentrate.gov.it/portale/aree-tematiche/casa/agevolazioni/agevolazioni-per-le-ristrutturazioni-edilizie","tempistica":"Detrazione in 10 anni","procedura":["Esegui i lavori e paga tramite bonifico parlante.","Indica le spese nella dichiarazione dei redditi allegando la documentazione."],"categoria":"Casa"},{"id":"b05","titolo":"Ecobonus","descrizione":"Detrazione in 10 anni: 50% su prima casa, 36% su seconda, con limiti di spesa specifici","valoreEsimato":null,"status":"attivo","difficolta":"alta","requisiti":["Interventi che migliorano l’efficienza energetica dell’immobile","Immobili esistenti","Rispetto dei limiti di spesa e vincoli tecnici previsti"],"documenti":["Fatture e bonifici parlanti","Eventuale documentazione tecnica/asseverazioni","Documentazione immobile"],"linkPortale":"https://bonusfiscali.enea.it/","tempistica":"Detrazione in 10 anni","procedura":["Esegui gli interventi di efficientamento energetico.","Indica le spese nella dichiarazione dei redditi."],"categoria":"Casa"},{"id":"b06","titolo":"Sismabonus","descrizione":"Detrazione in 10 anni (50% prima casa, 36% altre) su massimo 96.000 euro per unità immobiliare","valoreEsimato":null,"status":"attivo","difficolta":"alta","requisiti":["Interventi antisismici su immobili situati in zone ammesse","Rispetto della normativa tecnica sugli interventi strutturali"],"documenti":["Fatture e bonifici parlanti","Progetti e certificazioni tecniche","Documentazione immobile"],"linkPortale":"https://www.agenziaentrate.gov.it/portale/aree-tematiche/casa/agevolazioni/sisma-bonus","tempistica":"Detrazione in 10 anni","procedura":["Esegui gli interventi antisismici con tecnici abilitati.","Indica le spese nella dichiarazione dei redditi."],"categoria":"Casa"},{"id":"b07","titolo":"Bonus Mobili ed Elettrodomestici","descrizione":"Detrazione IRPEF del 50% per l'acquisto di mobili e grandi elettrodomestici in seguito a ristrutturazione.","valoreEsimato":2500,"status":"in arrivo","scadenza":"2024-12-31","difficolta":"alta","requisiti":["Ristrutturazione edilizia iniziata dopo il 1° gennaio dell'anno precedente","Elettrodomestici classe A+ o superiore"],"documenti":["Bonifici parlanti","Fatture di acquisto","Pratica edilizia (CILA/SCIA)"],"linkPortale":"https://www.agenziaentrate.gov.it/portale/web/guest/schede/agevolazioni/detrazione-ristrutturazioni-edilizie/bonus-mobili","tempistica":"Detrazione in 10 anni","procedura":["Avvia una pratica di ristrutturazione edilizia.","Acquista i beni tramite bonifico parlante o carta di credito/debito.","Conserva fatture e ricevute di pagamento.","Porta le spese in detrazione nella successiva dichiarazione dei redditi."],"categoria":"Casa"},{"id":"b08","titolo":"Bonus Verde","descrizione":"Detrazione del 36% per la sistemazione a verde di aree scoperte private di edifici esistenti.","valoreEsimato":1800,"status":"attivo","scadenza":"2024-12-31","difficolta":"media","requisiti":["Interventi su balconi, terrazzi o giardini condominiali/privati"],"documenti":["Bonifici ordinari","Fatture dei lavori effettuati"],"linkPortale":"https://www.agenziaentrate.gov.it/portale/aree-tematiche/casa/agevolazioni/agevolazioni-risparmio-energetico","tempistica":"Detrazione in 10 anni","procedura":["Affida i lavori di sistemazione a ditte specializzate.","Assicurati che i pagamenti siano tracciabili (bonifico, carta).","Le spese non devono superare i 5.000€ per unità immobiliare.","Indica le quote annuali nella dichiarazione dei redditi."],"categoria":"Casa"},{"id":"b09","titolo":"Bonus Acqua Potabile","descrizione":"Credito d'imposta del 50% per l'acquisto di sistemi di filtraggio e mineralizzazione dell'acqua.","valoreEsimato":500,"status":"attivo","scadenza":"2024-12-31","difficolta":"media","requisiti":["Persone fisiche o esercenti attività"],"documenti":["Fattura","Comunicazione all'Enea (se richiesto)","Bonifico"],"linkPortale":"https://www.agenziaentrate.gov.it/portale/bonus-acqua-potabile/infogen-bonus-acqua-potabile","tempistica":"Credito d'imposta","procedura":["Acquista e installa il sistema di filtraggio.","Invia la comunicazione delle spese sostenute all'Agenzia delle Entrate nel mese di febbraio dell'anno successivo.","Ricevi la percentuale spettante del credito d'imposta.","Usa il credito in compensazione tramite modello F24."],"categoria":"Casa"},{"id":"b10","titolo":"Bonus Affitto Under 31","descrizione":"Agevolazione fiscale per giovani che stipulano un contratto di locazione per l'abitazione principale.","valoreEsimato":2000,"status":"attivo","scadenza":"2024-12-31","difficolta":"media","requisiti":["Età tra 20 e 31 anni non compiuti","Reddito annuo sotto 15.493,71€","Residenza diversa dai genitori"],"documenti":["Contratto di affitto registrato","Certificato di residenza"],"linkPortale":"https://www.agenziaentrate.gov.it/portale/aree-tematiche/casa/agevolazioni/agevolazioni-per-acquisto-della-prima-casa","tempistica":"In sede di dichiarazione redditi (730)","procedura":["Registra regolarmente il contratto di locazione.","Sposta la residenza nell'immobile affittato.","Indica le spese sostenute nella dichiarazione dei redditi (730 o PF).","L'Agenzia delle Entrate applicherà la detrazione calcolata."],"categoria":"Casa"},{"id":"b11","titolo":"Bonus Condizionatori","descrizione":"Agevolazione per l'acquisto di condizionatori a pompa di calore, anche senza ristrutturazione.","valoreEsimato":500,"status":"attivo","scadenza":"2024-12-31","difficolta":"media","requisiti":["Acquisto di impianti ad alta efficienza energetica"],"documenti":["Fattura","Bonifico parlante","Dati tecnici dell'impianto"],"linkPortale":"https://www.agenziaentrate.gov.it/portale/aree-tematiche/casa/agevolazioni/agevolazioni-risparmio-energetico","tempistica":"Detrazione 50-65% in 10 anni","procedura":["Scegli un condizionatore certificato ad alta efficienza energetica.","Effettua il pagamento esclusivamente con bonifico parlante.","Conserva la certificazione del tecnico installatore.","Recupera il 50% o 65% della spesa tramite la dichiarazione dei redditi."],"categoria":"Casa"},{"id":"b12","titolo":"Carta acquisti","descrizione":"Carta prepagata per spese alimentari, sanitarie e pagamento di bollette luce e gas.","valoreEsimato":80,"status":"attivo","difficolta":"media","requisiti":["Età pari o superiore a 65 anni oppure genitore di bambino sotto i 3 anni","ISEE inferiore a 8.230,81 euro"],"documenti":["Documento di identità","Codice fiscale","Attestazione ISEE"],"linkPortale":"https://www.inps.it/it/it/dettaglio-approfondimento.schede-informative.la-carta-acquisti.html","tempistica":"Contributo periodico caricato sulla carta","procedura":["Compila i moduli disponibili presso gli Uffici postali o sui siti indicati.","Presenta la domanda secondo le modalità previste (Poste, INPS, ecc.)."],"categoria":"Sostegno al reddito"},{"id":"b13","titolo":"Carta “Dedicata a te”","descrizione":"Carta per l’acquisto di beni di prima necessità destinata a nuclei con ISEE basso.","valoreEsimato":500,"status":"attivo","difficolta":"bassa","requisiti":["ISEE fino a 15.000 euro","Nuclei selezionati da INPS e Comuni secondo criteri stabiliti"],"documenti":["Documento di identità","Codice fiscale"],"linkPortale":"https://www.inps.it/it/it/inps-comunica/notizie/dettaglio-news-page.news.2025.09.carta-dedicata-a-te-2025-istruzioni.html","tempistica":"Contributo da 500 euro per nucleo familiare","procedura":["Attendi la comunicazione di assegnazione da INPS/Comune.","Ritira la carta presso gli Uffici postali secondo le istruzioni ricevute."],"categoria":"Sostegno al reddito"},{"id":"b14","titolo":"Bonus mamme lavoratrici","descrizione":"Agevolazione economica annua per lavoratrici madri per favorire occupazione femminile e genitorialità.","valoreEsimato":720,"status":"attivo","difficolta":"bassa","requisiti":["Reddito da lavoro non superiore a 40.000 euro","Essere lavoratrice dipendente, autonoma o professionista","Avere 2 figli (più giovane under 10) o almeno 3 figli (più giovane under 18, secondo il tipo di contratto)"],"documenti":["Documento di identità","Codice fiscale dei figli","Eventuale documentazione lavorativa richiesta"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.nuovo-bonus-mamme.html","tempistica":"Fino a 720 euro annui","procedura":["Richiedi il beneficio tramite il datore di lavoro.","Comunica il numero e i codici fiscali dei figli come richiesto."],"categoria":"Lavoro"},{"id":"b15","titolo":"Bonus ai lavoratori fragili - Indennità una tantum","descrizione":"Indennità una tantum per lavoratori fragili del settore privato.","valoreEsimato":null,"status":"attivo","difficolta":"media","requisiti":["Lavoratore del settore privato","Condizione di fragilità come da normativa","Altri requisiti previsti dal bando"],"documenti":["Documento di identità","Certificazione medica","Documentazione lavorativa"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.58989.bonus-ai-lavoratori-fragili---indennit-una-tantum.html","tempistica":"Una tantum, erogata dopo l’istruttoria INPS","procedura":["Accedi all’area riservata del portale INPS con SPID, CIE o CNS.","Cerca il servizio “Bonus ai lavoratori fragili - Indennità una tantum”.","Compila la domanda online allegando la documentazione richiesta.","Invia la domanda e verifica lo stato nella tua area personale."],"categoria":"Lavoro"},{"id":"b16","titolo":"Bonus Patente","descrizione":"Rimborso dell'80% delle spese sostenute per conseguire la patente e l'abilitazione professionale CQC.","valoreEsimato":2500,"status":"scaduto","scadenza":"2026-12-31","difficolta":"media","requisiti":["Età tra 18 e 35 anni","Settore dell'autotrasporto"],"documenti":["Fatture delle autoscuole","Contratto di lavoro (per rimborso finale)"],"linkPortale":"https://patentiautotrasporto.mit.gov.it/bonuspatente/#/beneficiario/homePage","tempistica":"Voucher prenotabile","procedura":["Registrati sul portale del Ministero delle Infrastrutture.","Richiedi il voucher quando i fondi sono disponibili.","Consegna il voucher all'autoscuola aderente entro 60 giorni.","Consegui la patente entro il termine stabilito."],"categoria":"Lavoro"},{"id":"b17","titolo":"Supporto per la Formazione e il Lavoro (SFL)","descrizione":"Indennità mensile di 350€ per chi partecipa a progetti di formazione e orientamento al lavoro.","valoreEsimato":4200,"status":"in arrivo","difficolta":"alta","requisiti":["Età tra 18 e 59 anni","ISEE sotto 6.000€","Inscrizione al portale SIISL"],"documenti":["Patto di Attivazione Digitale","Attestazione di frequenza corsi"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.supporto-per-la-formazione-e-il-lavoro-sfl-.html","tempistica":"Mensile (durata max 12 mesi)","procedura":["Presenta la domanda tramite il sito INPS.","Accedi al portale SIISL e sottoscrivi il Patto di Attivazione Digitale.","Individua e partecipa a corsi di formazione accreditati.","Comunica l'avvio dell'attività per ricevere il pagamento mensile."],"categoria":"Lavoro"},{"id":"b18","titolo":"Bonus libri scolastici","descrizione":"Contributo per l’acquisto dei libri di testo per studenti delle scuole secondarie di secondo grado.","valoreEsimato":null,"status":"attivo","difficolta":"media","requisiti":["Studente iscritto a scuola secondaria di secondo grado","ISEE inferiore a 30.000 euro"],"documenti":["Documento di identità del genitore o dello studente","Codice fiscale dello studente","Attestazione ISEE"],"linkPortale":null,"tempistica":"Contributo definito dal Comune di residenza","procedura":["Presenta domanda tramite il Comune di residenza secondo il bando locale.","Allega la documentazione richiesta."],"categoria":"Studio"},{"id":"b19","titolo":"Bonus scuole paritarie","descrizione":"Contributo alle famiglie per iscrizione dei figli a scuole paritarie.","valoreEsimato":1500,"status":"in arrivo","difficolta":"media","requisiti":["Iscrizione a scuola paritaria (medie o primo biennio superiori)","ISEE fino a 30.000 euro"],"documenti":["Documento di identità del genitore","Codice fiscale del figlio","Attestazione ISEE"],"linkPortale":"https://www.mim.gov.it/contributi","tempistica":"Contributo una tantum da 1.500 euro","procedura":["Presenta domanda online tramite il portale del MIM.","Segui le istruzioni riportate nel bando per allegare i documenti richiesti."],"categoria":"Studio"},{"id":"b20","titolo":"Bonus psicologo","descrizione":"Sostegno economico per percorsi psicoterapeutici rivolto a persone che hanno avuto ripercussioni psicologiche, anche a causa della pandemia.","valoreEsimato":null,"status":"attivo","difficolta":"media","requisiti":["Residenza in Italia","Requisiti ISEE previsti dalla normativa","Presenza di disagio psicologico attestato"],"documenti":["Documento di identità","ISEE in corso di validità","Eventuale certificazione sanitaria"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.contributo-per-sostenere-le-spese-relative-a-sessioni-di-psicoterapia-bonus-psicologo.html","tempistica":"Entro la finestra temporale annuale prevista dai bandi","procedura":["Accedi al portale INPS con SPID, CIE o CNS.","Cerca il servizio “Bonus psicologo”.","Compila la domanda inserendo i dati richiesti e l’ISEE.","Attendi l’esito della richiesta e utilizza il codice assegnato presso i professionisti aderenti."],"categoria":"Salute"},{"id":"b21","titolo":"Bonus Occhiali (Bonus Vista)","descrizione":"Voucher o rimborso per l'acquisto di occhiali da vista o lenti a contatto correttive.","valoreEsimato":50,"status":"scaduto","difficolta":"bassa","requisiti":["ISEE sotto 10.000€","Acquisto effettuato tra 2021 e 2023"],"documenti":["Fattura o scontrino parlante","Prescrizione medica"],"linkPortale":"https://www.bonusvista.it/","tempistica":"Rimborso una tantum","procedura":["Verifica che l'acquisto sia avvenuto nel periodo di validità.","Accedi al portale dedicato del Ministero della Salute.","Carica i dati della fattura e l'ISEE dell'epoca.","Attendi l'accredito del rimborso sul conto corrente."],"categoria":"Salute"},{"id":"b22","titolo":"Assegno di Inclusione (ADI)","descrizione":"Misura di sostegno economico e inclusione sociale per nuclei familiari con fragilità.","valoreEsimato":6000,"status":"attivo","difficolta":"alta","requisiti":["Nucleo con minori, disabili o over 60","ISEE sotto 9.360€","Residenza in Italia da almeno 2 anni"],"documenti":["ISEE","PAD (Patto Attivazione Digitale)","Accreditamento presso i servizi sociali"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.assegno-di-inclusione-adi.html","tempistica":"Mensile tramite Carta ADI","procedura":["Invia la domanda telematica all'INPS o tramite CAF.","Sottoscrivi il Patto di Attivazione Digitale (PAD) del nucleo.","Presentati al colloquio presso i Servizi Sociali del tuo Comune.","Ritira la Carta ADI presso l'ufficio postale dopo l'approvazione."],"categoria":"Famiglia"},{"id":"b23","titolo":"Bonus Nuovi Nati","descrizione":"È un contributo di sostegno al reddito introdotto dall’art. 1 comma 206 della legge 30 dicembre 2024, n. 207 a favore dei genitori, per incentivare la natalità e contribuire alle spese per il sostegno.","valoreEsimato":1000,"status":"attivo","scadenza":"2024-12-31","difficolta":"bassa","requisiti":["Figli a carico","Cittadinanza italiana o UE","Soggiorno in Italia"],"documenti":["Fattura","Comunicazione all'Enea (se richiesto)","Bonifico"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.bonus-nuovi-nati.html","tempistica":"Voucher (immediato)","procedura":["La domanda deve essere presentata, a pena di decadenza, entro 120 giorni dalla data di nascita, ovvero dalla data di ingresso in famiglia del minore .","La domanda può essere presentata cliccando, in questa pagina, su “Utilizza il servizio”, oppure tramite Contact Center Multicanale o rivolgendosi agli Istituti di patronato.","In caso di più figli è necessario presentare una domanda per ogni figlio."],"categoria":"Famiglia"},{"id":"b24","titolo":"Bonus asilo nido e forme di supporto presso la propria abitazione","descrizione":"Contributo per il pagamento delle rette di asili nido pubblici e privati o per assistenza domiciliare per minori.","valoreEsimato":null,"status":"attivo","difficolta":"media","requisiti":["Genitore di minore avente diritto","Iscrizione del minore ad asilo nido o necessità di assistenza domiciliare","Requisiti ISEE previsti"],"documenti":["Documento di identità","Codice fiscale del minore","ISEE in corso di validità","Fatture o ricevute delle rette"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.bonus-asilo-nido-e-forme-di-supporto-presso-la-propria-abitazione-51105.bonus-asilo-nido-e-forme-di-supporto-presso-la-propria-abitazione.html","tempistica":"Annuale, con erogazione a seguito di verifica delle ricevute","procedura":["Accedi all’area riservata del portale INPS con SPID, CIE o CNS.","Seleziona il servizio “Bonus asilo nido e forme di supporto presso la propria abitazione”.","Compila la domanda indicando i dati del minore e della struttura o dell’assistenza domiciliare.","Allega le ricevute/fatture secondo le scadenze indicate e invia la domanda."],"categoria":"Famiglia"},"$5:2:props:bonus",{"id":"b26","titolo":"Bonus Cicogna – Contributo economico per nascita o adozione","descrizione":"Contributo economico per la nascita o l’adozione di figli per dipendenti del Gruppo Poste Italiane SpA e dipendenti ex IPOST.","valoreEsimato":null,"status":"attivo","difficolta":"media","requisiti":["Dipendente del Gruppo Poste Italiane SpA o ex IPOST","Nascita o adozione di un figlio nel periodo previsto dal bando"],"documenti":["Documento di identità","Attestazione di servizio","Certificato di nascita o adozione"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.bonus-cicogna-contributo-economico-per-nascita-o-adozione-gestione-postelegrafonici-e-fondo-ex-ipost.html","tempistica":"Secondo scadenze e graduatorie del bando","procedura":["Consulta il bando “Bonus Cicogna” sul sito INPS.","Accedi all’area riservata INPS con SPID, CIE o CNS.","Compila la domanda online entro i termini previsti dal bando.","Attendi la pubblicazione delle graduatorie e l’eventuale erogazione del contributo."],"categoria":"Famiglia"},{"id":"b27","titolo":"Nuovo Bonus mamme","descrizione":"Integrazione al reddito di 40 euro mensili per un massimo di 12 mensilità, erogati in unica soluzione, per madri lavoratrici con due o più figli.","valoreEsimato":480,"status":"attivo","difficolta":"media","requisiti":["Madre lavoratrice","Almeno due figli","Requisiti contributivi e lavorativi previsti"],"documenti":["Documento di identità","Documentazione lavorativa","Codici fiscali dei figli"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.nuovo-bonus-mamme.html","tempistica":"Erogazione in unica soluzione dopo l’istruttoria","procedura":["Accedi all’area riservata INPS con SPID, CIE o CNS.","Cerca il servizio “Nuovo Bonus mamme”.","Compila la domanda con i dati anagrafici, lavorativi e dei figli.","Invia la domanda e verifica l’esito nella sezione “Le mie domande”."],"categoria":"Famiglia"},{"id":"b28","titolo":"Bonus Trasporti 2024","descrizione":"Contributo per l'acquisto di abbonamenti ai mezzi pubblici locali, regionali e interregionali.","valoreEsimato":60,"status":"attivo","scadenza":"2024-12-31","difficolta":"bassa","requisiti":["Dipende dal comune di residenza","Reddito complessivo 2023 sotto 20.000€","Richiesta tramite portale Ministero"],"documenti":["Codice Fiscale","Dichiarazione redditi o autocertificazione"],"linkPortale":"https://bonustrasporti.lavoro.gov.it/","tempistica":"Immediata (voucher)","procedura":["Controlla il comune di residenza per verificare l'adesione al Bonus Trasporti.","Accedi al portale ufficiale tramite SPID o CIE.","Inserisci i dati del beneficiario e l'importo richiesto.","Scegli il gestore del servizio di trasporto.","Ottieni il codice del voucher da presentare all'acquisto."],"categoria":"Mobilità"},{"id":"b29","titolo":"Carta Giovani Nazionale (CGN)","descrizione":"Sconti e agevolazioni per giovani tra 18 e 35 anni su cultura, viaggi, sport e formazione.","valoreEsimato":300,"status":"attivo","difficolta":"bassa","requisiti":["Età tra 18 e 35 anni","Residenza in Italia"],"documenti":["App IO","SPID o CIE"],"linkPortale":"https://giovani2030.it/iniziativa/carta-giovani-nazionale/","tempistica":"Immediata (tramite App IO)","procedura":["Scarica l'app IO sul tuo smartphone.","Accedi con SPID o CIE.","Entra nella sezione \"Portafoglio\" e richiedi la carta.","Usa i codici sconto o mostra il QR code presso gli esercenti."],"categoria":"Giovani"},{"id":"b30","titolo":"Bonus Giovani Partita IVA","descrizione":"Sussidio di 500 euro al mese per 36 mesi (totale 18.000 euro) destinato a giovani under 35 che avviano un'attività imprenditoriale o professionale con partita IVA.","valoreEsimato":500,"status":"attivo","scadenza":"2026-03-02","difficolta":"media","requisiti":["Età inferiore a 35 anni alla data di avvio dell'attività","Partita IVA aperta tra il 1° luglio 2024 e il 31 dicembre 2025","Stato di disoccupazione all'apertura dell'attività (reddito sotto 8.145€ da lavoro dipendente o 4.800€ da lavoro autonomo)","Per le partite IVA: codici Ateco ammessi (69 - attività legali e contabilità, 70 - consulenza gestionale, 71 - architettura e ingegneria, 72 - ricerca scientifica, 73 - pubblicità e ricerche di mercato, 74 - altre attività professionali, 75 - servizi veterinari)"],"documenti":["Documento di identità","Codice fiscale","Documentazione apertura partita IVA","Attestazione stato di disoccupazione"],"linkPortale":"https://www.inps.it/it/it/dettaglio-scheda.it.schede-servizio-strumento.schede-servizi.incentivo-decreto-coesione-domanda.html","tempistica":"Erogazione mensile di 500 euro per 36 mesi","procedura":["Accedi alla piattaforma telematica INPS con SPID, CIE o CNS.","Cerca il servizio dedicato al Bonus Giovani del Decreto Coesione.","Compila la domanda online entro il 2 marzo 2026.","Attendi l'esito dell'istruttoria e ricevi le rate mensili."],"categoria":"Giovani"}]}]]
